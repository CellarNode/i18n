{
  "name": "@cellarnode/i18n",
  "version": "0.4.1",
  "description": "Shared i18n configuration for CellarNode frontends — language constants, i18next factory, browser locale detection, and common translations.",
  "license": "UNLICENSED",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CellarNode/i18n.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./config": {
      "types": "./dist/i18next-config.d.ts",
      "default": "./dist/i18next-config.js"
    },
    "./locales/*": "./locales/*",
    "./scripts/copy-common": "./dist/scripts/copy-common.js"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "locales"
  ],
  "keywords": [
    "cellarnode",
    "i18n",
    "i18next",
    "internationalization",
    "localization"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "i18next": "^26.4.2",
    "i18next-browser-languagedetector": "^8.2.1",
    "i18next-http-backend": "^4.0.2"
  },
  "peerDependencies": {
    "react-i18next": ">=15.0.0"
  },
  "devDependencies": {
    "@types/node": "^25.9.9",
    "react-i18next": "^17.0.16",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
